<div class="page">
  <div class="page-header">
    <h1 class="page-title">Job details</h1>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Edit", edit_job_path(@job), class: "btn btn-primary" %>
      <% if @job.invoice.present? %>
        <%= link_to "View Invoice", job_invoice_path(@job), class: "btn btn-primary" %>
      <% else %>
        <%= link_to "Create Invoice", job_invoice_path(@job), data: { turbo_method: :post }, class: "btn btn-primary" %>
      <% end %>
      <%= link_to "Back", jobs_path, class: "btn btn-outline" %>
    </div>
  </div>

  <div class="grid md:grid-cols-3 gap-6">
    <!-- Main Content -->
    <div class="md:col-span-2 space-y-4">
      <!-- Customer & Status -->
      <div class="card card-body">
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <p class="text-sm text-muted">Customer</p>
            <p class="text-lg font-semibold text-ink-2">
              <%= link_to @job.customer.full_name, customer_path(@job.customer), class: "link" %>
            </p>
          </div>
          <div>
            <p class="text-sm text-muted">Status</p>
            <p class="text-lg font-semibold">
              <span class="badge <%= { "completed" => "badge-success", "in_progress" => "badge-warning", "cancelled" => "badge-danger" }.fetch(@job.status.to_s, "badge-ghost") %>">
                <%= @job.status.to_s.humanize %>
              </span>
            </p>
          </div>
        </div>
      </div>

      <!-- Equipment Details -->
      <div class="card card-body space-y-4">
        <h2 class="text-lg font-semibold text-ink-2">Equipment</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <p class="text-sm text-muted">Model Number</p>
            <p class="text-ink-2"><%= @job.model_number || 'Not specified' %></p>
          </div>
          <div>
            <p class="text-sm text-muted">Serial Number</p>
            <p class="text-ink-2"><%= @job.serial_number || 'Not specified' %></p>
          </div>
        </div>
      </div>

      <!-- Service Details -->
      <div class="card card-body space-y-4">
        <h2 class="text-lg font-semibold text-ink-2">Service Details</h2>
        
        <% if @job.complaint.present? %>
          <div>
            <p class="text-sm text-muted">Complaint</p>
            <p class="text-ink-2 whitespace-pre-wrap"><%= @job.complaint %></p>
          </div>
        <% end %>

        <% if @job.diagnosis.present? %>
          <div>
            <p class="text-sm text-muted">Diagnosis</p>
            <p class="text-ink-2 whitespace-pre-wrap"><%= @job.diagnosis %></p>
          </div>
        <% end %>

        <% if @job.work_performed.present? %>
          <div>
            <p class="text-sm text-muted">Work Performed</p>
            <p class="text-ink-2 whitespace-pre-wrap"><%= @job.work_performed %></p>
          </div>
        <% end %>

        <% if @job.notes.present? %>
          <div>
            <p class="text-sm text-muted">Notes</p>
            <p class="text-ink-2 whitespace-pre-wrap"><%= @job.notes %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-4">
      <!-- Scheduling -->
      <div class="card card-body space-y-4">
        <h3 class="font-semibold text-ink-2">Scheduling</h3>
        <div>
          <p class="text-sm text-muted">Scheduled For</p>
          <p class="text-ink-2">
            <%= @job.starts_at&.strftime('%b %d, %Y at %I:%M %p') || 'Not scheduled' %>
          </p>
        </div>
        <div>
          <p class="text-sm text-muted">Technician</p>
          <% if @job.technician.present? %>
            <p class="text-ink-2">
              <%= link_to @job.technician.name, technician_path(@job.technician), class: "link" %>
            </p>
          <% else %>
            <span class="text-muted">Unassigned</span>
          <% end %>
        </div>
      </div>

      <!-- Timeline -->
      <div class="card card-body space-y-4">
        <h3 class="font-semibold text-ink-2">Timeline</h3>
        <div>
          <p class="text-sm text-muted">Created</p>
          <p class="text-ink-2"><%= @job.created_at.strftime('%b %d, %Y') %></p>
        </div>
        <div>
          <p class="text-sm text-muted">Updated</p>
          <p class="text-ink-2"><%= @job.updated_at.strftime('%b %d, %Y') %></p>
        </div>
      </div>
    </div>
  </div>
</div>
