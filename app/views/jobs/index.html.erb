<%
  status_badge = ->(status) {
    case status
    when "completed"   then "badge-success"
    when "in_progress" then "badge-warning"
    when "cancelled"   then "badge-danger"
    else "badge-ghost"
    end
  }
  filtering = @query.present? || @status.present?
%>
<div class="page">
  <header class="page-header">
    <div>
      <p class="eyebrow">Work</p>
      <h1 class="page-title mt-1">Jobs</h1>
      <p class="page-sub">Service calls across your team.</p>
    </div>
    <%= link_to new_job_path, class: "btn btn-primary" do %><%= icon "plus", css: "h-4 w-4" %> New job<% end %>
  </header>

  <%= form_with url: jobs_path, method: :get, local: true, class: "card card-body", role: "search" do |f| %>
    <div class="grid items-end gap-4 md:grid-cols-[1fr_14rem_auto]">
      <div>
        <%= label_tag :q, "Search", class: "label" %>
        <%= f.text_field :q, placeholder: "Customer name, model, serial…", value: @query, class: "input", type: "search", autocomplete: "off" %>
      </div>
      <div>
        <%= label_tag :status, "Status", class: "label" %>
        <%= f.select :status, [""] + @statuses, { selected: @status }, class: "input" %>
      </div>
      <div class="flex gap-2">
        <%= f.submit "Search", class: "btn btn-primary" %>
        <%= link_to "Clear", jobs_path, class: "btn btn-outline" if filtering %>
      </div>
    </div>
  <% end %>

  <div class="card overflow-hidden">
    <% if @jobs.any? %>
      <div class="table-wrap">
        <table class="table">
          <caption class="sr-only">Jobs</caption>
          <thead>
            <tr>
              <th scope="col">Customer</th>
              <th scope="col">Status</th>
              <th scope="col">Scheduled</th>
              <th scope="col">Technician</th>
              <th scope="col">Model</th>
              <th scope="col" class="text-right"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @jobs.each do |job| %>
              <tr>
                <td class="max-w-[16rem] truncate font-medium">
                  <%= link_to job.customer.full_name, job_path(job), class: "link" %>
                </td>
                <td><span class="badge <%= status_badge.call(job.status) %>"><%= job.status.to_s.humanize %></span></td>
                <td class="whitespace-nowrap"><%= job.starts_at&.strftime('%b %d, %Y') || "—" %></td>
                <td><%= job.technician&.name || "—" %></td>
                <td class="font-mono text-xs"><%= job.model_number.presence || "—" %></td>
                <td class="text-right">
                  <div class="inline-flex items-center gap-3 whitespace-nowrap">
                    <%= link_to "View", job_path(job), class: "link" %>
                    <%= link_to "Edit", edit_job_path(job), class: "link" %>
                    <%= button_to "Delete", job_path(job), method: :delete, form: { data: { turbo_confirm: "Delete this job? This can't be undone." }, class: "inline" }, class: "link-danger" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty">
        <span class="empty-icon"><%= icon "inbox", css: "h-6 w-6" %></span>
        <% if filtering %>
          <p class="empty-title">No jobs match your search</p>
          <p class="empty-text">Try a different customer name, model, or status.</p>
          <%= link_to "Clear filters", jobs_path, class: "btn btn-outline btn-sm mt-2" %>
        <% else %>
          <p class="empty-title">No jobs yet</p>
          <p class="empty-text">Create your first service call to start scheduling work.</p>
          <%= link_to "New job", new_job_path, class: "btn btn-primary btn-sm mt-2" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
