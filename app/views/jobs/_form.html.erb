<%= form_with model: @job, local: true, class: "space-y-6" do |f| %>
  <% if @job.errors.any? %>
    <div class="notice notice-error">
      <p class="font-semibold mb-1"><%= pluralize(@job.errors.count, "error") %> prevented saving:</p>
      <ul class="list-disc pl-5">
        <% @job.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Customer & Scheduling -->
  <div class="space-y-4">
    <h2 class="text-lg font-semibold text-ink-2">Customer & Scheduling</h2>
    
    <div class="grid md:grid-cols-2 gap-4">
      <div data-controller="customer-search">
        <label for="customer-search-input" class="label">Customer *</label>
        <div class="relative">
          <div class="input px-3 py-2 flex flex-wrap gap-2 items-center min-h-[42px]">
            <input 
              type="text" 
              data-customer-search-target="input"
              id="customer-search-input"
              placeholder="Type to search..." 
              class="flex-1 bg-transparent outline-none text-sm min-w-[150px]"
              autocomplete="off"
              data-action="input->customer-search#handleInput focus->customer-search#handleFocus keydown->customer-search#handleKeydown" />
          </div>
          <div 
            data-customer-search-target="dropdown"
            class="hidden absolute top-full left-0 right-0 mt-1 bg-raised border border-line rounded-md shadow-lg z-10 max-h-64 overflow-y-auto">
          </div>
        </div>
        <%= f.hidden_field :customer_id, data: { "customer-search-target" => "customerId" } %>
      </div>
      <div>
        <%= f.label :starts_at, "Scheduled Date & Time", class: "label" %>
        <%= f.datetime_local_field :starts_at, class: "input" %>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <%= f.label :technician_id, "Technician", class: "label" %>
        <%= f.collection_select :technician_id, @technicians, :id, :name,
            { prompt: "Unassigned" },
            class: "input" %>
      </div>
      <div>
        <%= f.label :status, "Status", class: "label" %>
        <%= f.select :status, 
            [ ["Pending", "pending"], ["In Progress", "in_progress"], ["Completed", "completed"], ["Cancelled", "cancelled"] ],
            { prompt: "Select status" },
            class: "input" %>
      </div>
    </div>
  </div>

  <!-- Equipment Information -->
  <div class="space-y-4">
    <h2 class="text-lg font-semibold text-ink-2">Equipment Information</h2>
    
    <div class="grid md:grid-cols-2 gap-4" data-controller="job-equipment-normalize">
      <div>
        <%= f.label :model_number, "Model Number", class: "label" %>
        <%= f.text_field :model_number, 
            data: { "job-equipment-normalize-target" => "modelNumber" },
            class: "input", 
            placeholder: "e.g. ABC-123",
            "data-action" => "blur->job-equipment-normalize#normalizeModelNumber" %>
      </div>
      <div>
        <%= f.label :serial_number, "Serial Number", class: "label" %>
        <%= f.text_field :serial_number, 
            data: { "job-equipment-normalize-target" => "serialNumber" },
            class: "input", 
            placeholder: "e.g. SN-987654",
            "data-action" => "blur->job-equipment-normalize#normalizeSerialNumber" %>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <%= f.label :appliance_type, "Appliance Type", class: "label" %>
        <%= f.select :appliance_type,
            [ ["Washer", "washer"], ["Dryer", "dryer"], ["Refrigerator", "refrigerator"], 
              ["Range", "range"], ["Dishwasher", "dishwasher"], ["Microwave", "microwave"], 
              ["Other", "other"] ],
            { prompt: "Select type" },
            class: "input" %>
      </div>
      <div>
        <%= f.label :brand, "Brand", class: "label" %>
        <%= f.select :brand,
            [ ["Whirlpool", "Whirlpool"], ["GE", "GE"], ["LG", "LG"], ["Samsung", "Samsung"],
              ["Frigidaire", "Frigidaire"], ["Bosch", "Bosch"], ["KitchenAid", "KitchenAid"],
              ["Maytag", "Maytag"], ["Amana", "Amana"], ["Electrolux", "Electrolux"],
              ["Sub-Zero", "Sub-Zero"], ["Other", "Other"] ],
            { prompt: "Select brand" },
            class: "input" %>
      </div>
    </div>
  </div>

  <!-- Service Details -->
  <div class="space-y-4" data-controller="job-complaint-helpers">
    <h2 class="text-lg font-semibold text-ink-2">Service Details</h2>
    
    <div>
      <%= f.label :complaint, "Customer Complaint *", class: "label" %>
      
      <!-- Quick fill buttons -->
      <div class="flex flex-wrap gap-2 mb-2">
        <button type="button" 
                class="btn btn-outline btn-sm"
                data-action="click->job-complaint-helpers#addComplaint"
                data-complaint-text="Not cooling">Not cooling</button>
        <button type="button" 
                class="btn btn-outline btn-sm"
                data-action="click->job-complaint-helpers#addComplaint"
                data-complaint-text="Not draining">Not draining</button>
        <button type="button" 
                class="btn btn-outline btn-sm"
                data-action="click->job-complaint-helpers#addComplaint"
                data-complaint-text="Won't start">Won't start</button>
        <button type="button" 
                class="btn btn-outline btn-sm"
                data-action="click->job-complaint-helpers#addComplaint"
                data-complaint-text="Leaking">Leaking</button>
        <button type="button" 
                class="btn btn-outline btn-sm"
                data-action="click->job-complaint-helpers#addComplaint"
                data-complaint-text="No heat">No heat</button>
      </div>

      <%= f.text_area :complaint, 
          data: { "job-complaint-helpers-target" => "complaintTextarea" },
          rows: 3, 
          class: "input", 
          placeholder: "Describe the issue reported by the customer" %>
    </div>

    <div>
      <%= f.label :diagnosis, "Diagnosis", class: "label" %>
      <%= f.text_area :diagnosis, rows: 3, class: "input", placeholder: "What was found during inspection?" %>
    </div>

    <div>
      <%= f.label :work_performed, "Work Performed", class: "label" %>
      <%= f.text_area :work_performed, rows: 3, class: "input", placeholder: "Describe the work completed" %>
    </div>

    <div>
      <%= f.label :notes, class: "label" do %>Internal Notes <span class="font-normal text-muted">(optional)</span><% end %>
      <%= f.text_area :notes, rows: 3, class: "input", placeholder: "Internal notes for your team" %>
    </div>
  </div>

  <div class="flex items-center gap-3 pt-4">
    <%= f.submit (@job.new_record? ? "Create Job" : "Save Changes"),
        class: "btn btn-primary",
        name: "commit" %>
    <%= f.submit (@job.new_record? ? "Save & Create Another" : "Save & New"),
        class: "btn btn-outline",
        name: "commit_action",
        value: "save_new" %>
    <%= link_to "Cancel", (@job.new_record? ? jobs_path : @job),
        class: "btn btn-outline" %>
  </div>
<% end %>
