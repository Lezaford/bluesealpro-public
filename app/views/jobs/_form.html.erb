<%= form_with model: @job, local: true, class: "space-y-6" do |f| %>
  <% if @job.errors.any? %>
    <div class="rounded-md border border-red-500/30 bg-red-50/5 px-4 py-3 text-red-300">
      <p class="font-semibold mb-1"><%= pluralize(@job.errors.count, "error") %> prevented saving:</p>
      <ul class="list-disc pl-5">
        <% @job.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Customer & Scheduling -->
  <div class="space-y-4">
    <h2 class="text-lg font-semibold text-slate-200">Customer & Scheduling</h2>
    
    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm text-slate-300 mb-1">Customer *</label>
        <div class="relative">
          <div id="customer-input-wrapper" class="w-full rounded-md bg-slate-800 border border-slate-700 text-slate-100 focus:border-blue-500 focus:ring-blue-500 px-3 py-2 flex flex-wrap gap-2 items-center min-h-[42px]">
            <input type="text" id="customer-search" placeholder="Type to search..." 
              class="flex-1 bg-transparent outline-none text-sm min-w-[150px]"
              autocomplete="off" />
          </div>
          <div id="customer-dropdown" class="hidden absolute top-full left-0 right-0 mt-1 bg-slate-800 border border-slate-700 rounded-md shadow-lg z-10 max-h-64 overflow-y-auto">
          </div>
        </div>
        <%= f.hidden_field :customer_id, id: "customer_id_field" %>
      </div>
      <div>
        <label class="block text-sm text-slate-300 mb-1">Scheduled Date & Time</label>
        <%= f.datetime_local_field :starts_at, class: "w-full rounded-md bg-slate-800 border border-slate-700 text-slate-100 focus:border-blue-500 focus:ring-blue-500" %>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm text-slate-300 mb-1">Technician</label>
        <%= f.collection_select :technician_id, @technicians, :id, :name,
            { prompt: "Unassigned" },
            class: "w-full rounded-md bg-slate-800 border border-slate-700 text-slate-100 focus:border-blue-500 focus:ring-blue-500" %>
      </div>
      <div>
        <label class="block text-sm text-slate-300 mb-1">Status</label>
        <%= f.select :status, 
            [ ["Pending", "pending"], ["In Progress", "in_progress"], ["Completed", "completed"], ["Cancelled", "cancelled"] ],
            { prompt: "Select status" },
            class: "w-full rounded-md bg-slate-800 border border-slate-700 text-slate-100 focus:border-blue-500 focus:ring-blue-500" %>
      </div>
    </div>
  </div>

  <!-- Equipment Information -->
  <div class="space-y-4">
    <h2 class="text-lg font-semibold text-slate-200">Equipment Information</h2>
    
    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm text-slate-300 mb-1">Model Number</label>
        <%= f.text_field :model_number, class: "w-full rounded-md bg-slate-800 border border-slate-700 text-slate-100 focus:border-blue-500 focus:ring-blue-500", placeholder: "e.g. ABC-123" %>
      </div>
      <div>
        <label class="block text-sm text-slate-300 mb-1">Serial Number</label>
        <%= f.text_field :serial_number, class: "w-full rounded-md bg-slate-800 border border-slate-700 text-slate-100 focus:border-blue-500 focus:ring-blue-500", placeholder: "e.g. SN-987654" %>
      </div>
    </div>
  </div>

  <!-- Service Details -->
  <div class="space-y-4">
    <h2 class="text-lg font-semibold text-slate-200">Service Details</h2>
    
    <div>
      <label class="block text-sm text-slate-300 mb-1">Customer Complaint *</label>
      <%= f.text_area :complaint, rows: 3, class: "w-full rounded-md bg-slate-800 border border-slate-700 text-slate-100 focus:border-blue-500 focus:ring-blue-500", placeholder: "Describe the issue reported by the customer" %>
    </div>

    <div>
      <label class="block text-sm text-slate-300 mb-1">Diagnosis</label>
      <%= f.text_area :diagnosis, rows: 3, class: "w-full rounded-md bg-slate-800 border border-slate-700 text-slate-100 focus:border-blue-500 focus:ring-blue-500", placeholder: "What was found during inspection?" %>
    </div>

    <div>
      <label class="block text-sm text-slate-300 mb-1">Work Performed</label>
      <%= f.text_area :work_performed, rows: 3, class: "w-full rounded-md bg-slate-800 border border-slate-700 text-slate-100 focus:border-blue-500 focus:ring-blue-500", placeholder: "Describe the work completed" %>
    </div>

    <div>
      <label class="block text-sm text-slate-300 mb-1">Internal Notes <span class="text-slate-500 font-normal">(optional)</span></label>
      <%= f.text_area :notes, rows: 3, class: "w-full rounded-md bg-slate-800 border border-slate-700 text-slate-100 focus:border-blue-500 focus:ring-blue-500", placeholder: "Internal notes for your team" %>
    </div>
  </div>

  <div class="flex items-center gap-3 pt-4">
    <%= f.submit (@job.new_record? ? "Create Job" : "Save Changes"),
        class: "rounded-md bg-blue-600 px-5 py-2.5 text-white hover:bg-blue-700" %>
    <%= link_to "Cancel", (@job.new_record? ? jobs_path : @job),
        class: "rounded-md border border-slate-600 px-5 py-2.5 hover:bg-slate-800" %>
  </div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const customers = <%= @customers.map { |c| { id: c.id, name: c.full_name, email: c.email } }.to_json.html_safe %>;
    const searchInput = document.getElementById('customer-search');
    const inputWrapper = document.getElementById('customer-input-wrapper');
    const dropdown = document.getElementById('customer-dropdown');
    const customerIdField = document.getElementById('customer_id_field');
    let selectedCustomerId = customerIdField.value;

    // Fuzzy search scoring function
    function fuzzyScore(searchStr, targetStr) {
      const search = searchStr.toLowerCase();
      const target = targetStr.toLowerCase();
      
      let score = 0;
      let searchIdx = 0;
      let lastMatchIdx = -1;
      
      for (let i = 0; i < target.length && searchIdx < search.length; i++) {
        if (search[searchIdx] === target[i]) {
          score += 100;
          
          if (lastMatchIdx === i - 1) {
            score += 50;
          }
          
          if (i === 0 || target[i - 1] === ' ' || target[i - 1] === '-') {
            score += 30;
          }
          
          lastMatchIdx = i;
          searchIdx++;
        }
      }
      
      if (searchIdx !== search.length) {
        return 0;
      }
      
      score -= (target.length - search.length);
      
      return score;
    }

    // Highlight matched characters
    function highlightMatches(str, query) {
      const search = query.toLowerCase();
      let result = '';
      let searchIdx = 0;
      
      for (let i = 0; i < str.length; i++) {
        if (searchIdx < search.length && search[searchIdx] === str[i].toLowerCase()) {
          result += `<span class="bg-blue-500 text-white font-semibold">${str[i]}</span>`;
          searchIdx++;
        } else {
          result += str[i];
        }
      }
      
      return result;
    }

    // Update selected customer display
    function updateSelectedCustomerDisplay() {
      const selected = customers.find(c => c.id == selectedCustomerId);
      if (selected) {
        searchInput.value = '';
        // Remove any existing customer chips
        inputWrapper.querySelectorAll('.customer-chip').forEach(chip => chip.remove());
        
        const chip = document.createElement('div');
        chip.className = 'customer-chip bg-blue-600/30 border border-blue-500 text-blue-200 px-3 py-1 rounded flex items-center gap-2 text-sm';
        chip.innerHTML = `
          <span>${selected.name}</span>
          <button type="button" class="remove-customer text-blue-300 hover:text-blue-100 font-bold">×</button>
        `;
        inputWrapper.insertBefore(chip, searchInput);
        
        chip.querySelector('.remove-customer').addEventListener('click', function(e) {
          e.preventDefault();
          clearSelectedCustomer();
        });
      }
    }

    function clearSelectedCustomer() {
      selectedCustomerId = null;
      customerIdField.value = '';
      inputWrapper.querySelectorAll('.customer-chip').forEach(chip => chip.remove());
      searchInput.value = '';
      searchInput.focus();
    }

    // Initialize with selected customer if editing
    if (customerIdField.value) {
      selectedCustomerId = customerIdField.value;
      updateSelectedCustomerDisplay();
    }

    // Show dropdown on focus
    searchInput.addEventListener('focus', function() {
      if (searchInput.value.length === 0 && !selectedCustomerId) {
        showTopCustomers();
      }
      dropdown.classList.remove('hidden');
    });

    function showTopCustomers() {
      dropdown.innerHTML = customers.slice(0, 8).map(customer => {
        return `
          <button type="button" class="w-full text-left px-3 py-2 hover:bg-slate-700 transition customer-option" data-id="${customer.id}" data-name="${customer.name}" data-email="${customer.email}">
            <div class="font-medium text-slate-100">${customer.name}</div>
            <div class="text-xs text-slate-400">${customer.email}</div>
          </button>
        `;
      }).join('');
      
      attachOptionHandlers();
    }

    function attachOptionHandlers() {
      document.querySelectorAll('.customer-option').forEach(option => {
        option.addEventListener('click', function(e) {
          e.preventDefault();
          selectedCustomerId = this.dataset.id;
          customerIdField.value = this.dataset.id;
          updateSelectedCustomerDisplay();
          dropdown.classList.add('hidden');
        });
      });
    }

    // Search functionality
    searchInput.addEventListener('input', function(e) {
      const query = e.target.value.trim();
      
      if (query.length === 0) {
        showTopCustomers();
        return;
      }

      const scored = customers
        .map(customer => ({
          ...customer,
          score: Math.max(fuzzyScore(query, customer.name), fuzzyScore(query, customer.email))
        }))
        .filter(customer => customer.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 8);

      if (scored.length === 0) {
        dropdown.innerHTML = '<div class="px-3 py-2 text-slate-400 text-sm">No customers found</div>';
        dropdown.classList.remove('hidden');
        return;
      }

      dropdown.innerHTML = scored.map(customer => {
        const highlightedName = highlightMatches(customer.name, query);
        const highlightedEmail = highlightMatches(customer.email, query);
        
        return `
          <button type="button" class="w-full text-left px-3 py-2 hover:bg-slate-700 transition customer-option" data-id="${customer.id}" data-name="${customer.name}" data-email="${customer.email}">
            <div class="font-medium text-slate-100">${highlightedName}</div>
            <div class="text-xs text-slate-400">${highlightedEmail}</div>
          </button>
        `;
      }).join('');

      dropdown.classList.remove('hidden');
      attachOptionHandlers();
    });

    // Close dropdown when clicking outside
    document.addEventListener('click', function(e) {
      if (!searchInput.contains(e.target) && !dropdown.contains(e.target) && !inputWrapper.contains(e.target)) {
        dropdown.classList.add('hidden');
      }
    });

    // Handle keyboard navigation
    searchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        dropdown.classList.add('hidden');
      }
    });
  });
</script>
