<div class="page">
  <div>
    <h1 class="page-title">New Technician</h1>
    <p class="mt-1 text-sm text-muted">Add a technician to your team. If you provide an email, a login account will be automatically created.</p>
  </div>
  <div class="card card-body">
    <%= form_with model: @technician, local: true, class: "space-y-6" do |f| %>
      <% if @technician.errors.any? %>
        <div class="notice notice-error">
          <p class="font-semibold mb-1"><%= pluralize(@technician.errors.count, "error") %> prevented saving:</p>
          <ul class="list-disc pl-5">
            <% @technician.errors.full_messages.each do |m| %>
              <li><%= m %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <%= f.label :name, "Name *", class: "label" %>
          <%= f.text_field :name, class: "input" %>
        </div>
        <div>
          <%= f.label :phone, "Phone *", class: "label" %>
          <%= f.telephone_field :phone, class: "input" %>
        </div>
      </div>

      <div>
        <%= f.label :email, "Email (Optional - creates login account)", class: "label" %>
        <%= f.email_field :email, class: "input" %>
        <p class="mt-1 text-xs text-muted">Provide an email to automatically create a BlueSealPro login for this technician. They'll receive a welcome email with temporary credentials.</p>
      </div>

      <div>
        <%= f.label :notes, "Notes", class: "label" %>
        <%= f.text_area :notes, rows: 4, class: "input" %>
      </div>

      <div class="flex items-center gap-2">
        <label class="flex items-center gap-2 text-sm text-ink-2">
          <%= f.check_box :active, class: "rounded" %>
          Active technician
        </label>
      </div>

      <div class="flex items-center gap-3 pt-4">
        <%= f.submit "Create Technician",
            class: "btn btn-primary" %>
        <%= link_to "Cancel", technicians_path,
            class: "btn btn-outline" %>
      </div>
    <% end %>
  </div>
</div>
