<div class="page">
  <div class="page-header">
    <div>
      <h1 class="page-title"><%= @technician.name %></h1>
      <p class="mt-1 text-sm text-muted">
        <span class="badge <%= @technician.active? ? "badge-success" : "" %>">
          <%= @technician.active? ? "Active" : "Inactive" %>
        </span>
      </p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_technician_path(@technician),
            class: "btn btn-outline" %>
      <%= link_to "Back", technicians_path,
            class: "btn btn-outline" %>
    </div>
  </div>

  <!-- Contact Information Card -->
  <div class="card card-body">
    <h2 class="text-lg font-semibold text-ink-2 mb-4">Contact Information</h2>
    
    <div class="space-y-4">
      <div>
        <p class="eyebrow">Phone</p>
        <p class="text-ink text-lg font-medium mt-1"><%= @technician.phone %></p>
      </div>

      <% if @technician.email.present? %>
        <div>
          <p class="eyebrow">Email</p>
          <p class="text-ink text-lg font-medium mt-1">
            <%= mail_to @technician.email, @technician.email, class: "link" %>
          </p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Notes Card -->
  <% if @technician.notes.present? %>
    <div class="card card-body">
      <h2 class="text-lg font-semibold text-ink-2 mb-4">Notes</h2>
      <div class="text-ink-2 whitespace-pre-wrap"><%= simple_format(@technician.notes) %></div>
    </div>
  <% end %>
</div>
