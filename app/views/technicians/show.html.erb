<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-extrabold"><%= @technician.name %></h1>
      <p class="mt-1 text-sm text-slate-400">
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= @technician.active? ? "bg-green-500/20 text-green-300" : "bg-slate-500/20 text-slate-300" %>">
          <%= @technician.active? ? "Active" : "Inactive" %>
        </span>
      </p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_technician_path(@technician),
            class: "rounded-md border border-slate-600 px-4 py-2 text-sm font-medium text-slate-100 hover:bg-slate-800" %>
      <%= link_to "Back", technicians_path,
            class: "rounded-md bg-slate-700 px-4 py-2 text-sm font-medium text-slate-100 hover:bg-slate-600" %>
    </div>
  </div>

  <!-- Contact Information Card -->
  <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6">
    <h2 class="text-lg font-semibold text-slate-200 mb-4">Contact Information</h2>
    
    <div class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase">Phone</label>
        <p class="text-slate-100 text-lg font-medium mt-1"><%= @technician.phone %></p>
      </div>

      <% if @technician.email.present? %>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase">Email</label>
          <p class="text-slate-100 text-lg font-medium mt-1">
            <%= mail_to @technician.email, @technician.email, class: "text-blue-400 hover:text-blue-300" %>
          </p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Notes Card -->
  <% if @technician.notes.present? %>
    <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6">
      <h2 class="text-lg font-semibold text-slate-200 mb-4">Notes</h2>
      <div class="text-slate-300 whitespace-pre-wrap"><%= simple_format(@technician.notes) %></div>
    </div>
  <% end %>
</div>
