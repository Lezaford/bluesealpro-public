<div class="page">
  <!-- Header + actions -->
  <div class="page-header">
    <div>
      <p class="eyebrow">Team</p>
      <h1 class="page-title mt-1">Technicians</h1>
      <p class="page-sub">
        Manage your field service team and their assignments.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <!-- New Technician -->
      <%= link_to new_technician_path, class: "btn btn-primary" do %><%= icon "plus", css: "h-4 w-4" %> Add technician<% end %>
    </div>
  </div>

  <!-- Table -->
  <% if @technicians.any? %>
    <div class="card overflow-hidden"><div class="table-wrap">
      <table class="table">
        <caption class="sr-only">Technicians</caption>
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Phone</th>
            <th scope="col">Email</th>
            <th scope="col">Status</th>
            <th scope="col"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @technicians.each do |technician| %>
            <tr>
              <td class="font-medium text-ink"><%= technician.name %></td>
              <td><%= technician.phone.presence || "—" %></td>
              <td><%= technician.email.presence || "—" %></td>
              <td>
                <span class="badge <%= technician.active? ? "badge-success" : "" %>">
                  <%= technician.active? ? "Active" : "Inactive" %>
                </span>
              </td>
              <td class="text-right">
                <div class="inline-flex gap-2">
                  <%= link_to "View", technician_path(technician),
                        class: "btn btn-outline btn-sm" %>
                  <%= link_to "Edit", edit_technician_path(technician),
                        class: "btn btn-outline btn-sm" %>
                  <%= button_to "Delete", technician_path(technician), method: :delete,
                        data: { turbo_confirm: "Delete this technician?" },
                        class: "btn btn-danger btn-sm" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div></div>
  <% else %>
    <div class="card empty">
      <span class="empty-icon"><%= icon "wrench", css: "h-6 w-6" %></span>
      <p class="empty-title">No technicians yet</p>
      <p class="empty-text">Add your field team so jobs can be assigned and scheduled.</p>
      <%= link_to "Create your first technician", new_technician_path, class: "btn btn-primary btn-sm mt-2" %>
    </div>
  <% end %>
</div>
