<div class="flex min-h-[calc(100vh-14rem)] items-center justify-center">
  <div class="w-full max-w-md animate-fade-up">
    <div class="card p-8">
      <h1 class="page-title !text-2xl">Log in</h1>
      <p class="page-sub mb-6">Use your BlueSealPro account to access the dashboard.</p>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <% if flash[:alert].present? %>
          <div class="notice notice-error mb-4" role="alert"><%= flash[:alert] %></div>
        <% end %>

        <div class="space-y-4">
          <div>
            <%= f.label :email, "Email", class: "label" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input" %>
          </div>

          <div>
            <div class="flex items-center justify-between">
              <%= f.label :password, "Password", class: "label" %>
              <% if devise_mapping.recoverable? %>
                <%= link_to "Forgot?", new_password_path(resource_name), class: "link mb-1.5 text-sm" %>
              <% end %>
            </div>
            <%= f.password_field :password, autocomplete: "current-password", class: "input" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <label class="inline-flex items-center gap-2 text-sm text-ink-2">
              <%= f.check_box :remember_me %>
              Remember me
            </label>
          <% end %>

          <div class="pt-2">
            <%= f.submit "Log in", class: "btn btn-primary btn-block !py-2.5" %>
          </div>
        </div>
      <% end %>
    </div>

    <p class="mt-6 text-center text-sm text-muted">
      Don’t have an account yet?
      <a href="<%= root_path %>#beta" class="link">Request beta access</a>
    </p>
  </div>
</div>
