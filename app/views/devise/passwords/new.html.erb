<div class="flex min-h-[calc(100vh-14rem)] items-center justify-center">
  <div class="max-w-md w-full">
    <div class="card p-8">
      <h1 class="page-title !text-2xl mb-2">Reset Password</h1>
      <p class="text-muted mb-6">Enter your email to receive password reset instructions.</p>

      <% if flash[:alert].present? %>
        <div class="notice notice-error mb-4">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="field mb-4">
          <%= f.label :email, "Email", class: "label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", 
              class: "input" %>
        </div>

        <div class="flex gap-3 mt-6">
          <%= f.submit "Send Reset Link", class: "btn btn-primary flex-1" %>
          <%= link_to "Back to login", new_session_path(resource_name), class: "btn btn-outline flex-1" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
