<div class="page">
  <!-- Header + actions -->
  <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="eyebrow">People</p>
      <h1 class="page-title mt-1">Customers</h1>
      <p class="page-sub">
        Search, filter, import, and export customer records for <%= Current.company.name %>.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <!-- Export CSV -->
      <%= link_to "Export CSV",
          export_customers_path(request.query_parameters.except("page")),
          class: "btn btn-outline" %>

      <!-- Import CSV -->
      <%= form_with url: import_customers_path,
                    multipart: true,
                    local: true,
                    id: "import-form",
                    class: "contents" do |f| %>
        <label class="btn btn-outline cursor-pointer">
          Import CSV
          <%= f.file_field :import_file,
                accept: ".csv",
                class: "hidden",
                onchange: "document.getElementById('import-form').submit()" %>
        </label>
      <% end %>

      <!-- New Customer -->
      <%= link_to "New Customer",
          new_customer_path,
          class: "btn btn-primary" %>
    </div>
  </div>

  <!-- Search + filters -->
  <%= form_with url: customers_path, method: :get, local: true, class: "max-w-4xl" do |f| %>
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <!-- Text search + buttons -->
      <div class="flex w-full gap-2">
        <%= text_field_tag :q, params[:q],
          placeholder: "Search name, email, phone…",
          class: "input", type: "search", "aria-label": "Search customers" %>

        <%= submit_tag "Search",
          class: "btn btn-outline" %>

        <% if params[:q].present? || params[:customer_type].present? || params[:lead_source].present? %>
          <%= link_to "Clear", customers_path,
            class: "btn btn-outline" %>
        <% end %>
      </div>

      <!-- Dropdown filters -->
      <div class="flex flex-wrap gap-2 md:justify-end">
        <%= select_tag :customer_type,
          options_for_select(
            [["All types", ""]] + @customer_types.map { |t| [t, t] },
            params[:customer_type]
          ),
          class: "input !w-auto", "aria-label": "Filter by customer type" %>

        <%= select_tag :lead_source,
          options_for_select(
            [["All sources", ""]] + @lead_sources.map { |s| [s, s] },
            params[:lead_source]
          ),
          class: "input !w-auto", "aria-label": "Filter by lead source" %>
      </div>
  </div>
<% end %>


  <!-- Table -->
  <div class="card overflow-hidden">
    <div class="table-wrap"><table class="table">
      <caption class="sr-only">Customers</caption>
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Email</th>
          <th scope="col">Phone</th>
          <th scope="col">City</th>
          <th scope="col">Type</th>
          <th scope="col">Last Service</th>
          <th scope="col">Lifetime Value</th>
          <th scope="col"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% @customers.each do |c| %>
          <tr>
            <td>
              <div class="flex flex-col">
                <span class="font-medium text-ink"><%= c.full_name %></span>
                <% if c.company_name.present? %>
                  <span class="text-xs text-muted"><%= c.company_name %></span>
                <% end %>
              </div>
            </td>
            <td><%= c.email.presence || "—" %></td>
            <td>
              <%= c.primary_phone || "—" %>
            </td>
            <td>
              <%= c.address_1_city.presence || "—" %>
            </td>
            <td>
              <%= c.customer_type.presence || "—" %>
            </td>
            <td>
              <%= c.last_service_date&.strftime("%b %-d, %Y") || "—" %>
            </td>
            <td>
              <% if c.lifetime_value.present? && c.lifetime_value.to_f > 0 %>
                <span class="font-mono">$<%= number_with_precision(c.lifetime_value, precision: 2) %></span>
              <% else %>
                —
              <% end %>
            </td>
            <td class="text-right">
              <div class="inline-flex gap-2">
                <%= link_to "View", c,
                      class: "btn btn-outline btn-sm" %>
                <%= link_to "Edit", edit_customer_path(c),
                      class: "btn btn-outline btn-sm" %>
                <%= button_to "Delete", c, method: :delete,
                      data: { turbo_confirm: "Delete this customer?" },
                      class: "btn btn-danger btn-sm" %>
              </div>
            </td>
          </tr>
        <% end %>

        <% if @customers.empty? %>
          <tr>
            <td colspan="8">
              <div class="empty">
                <span class="empty-icon"><%= icon "users", css: "h-6 w-6" %></span>
                <p class="empty-title"><%= params[:q].present? ? "No customers match your search" : "No customers yet" %></p>
                <p class="empty-text">Add a customer or import a CSV to get started.</p>
                <%= link_to "New customer", new_customer_path, class: "btn btn-primary btn-sm mt-2" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table></div>
  </div>

  <% if @total_pages > 1 %>
    <nav class="flex items-center justify-between" aria-label="Pagination">
      <p class="text-sm text-muted">
        Showing <%= (@page - 1) * @per_page + 1 %>&ndash;<%= [ @page * @per_page, @total_count ].min %> of <%= @total_count %>
      </p>
      <div class="flex items-center gap-2">
        <% if @page > 1 %>
          <%= link_to "Previous", customers_path(request.query_parameters.merge(page: @page - 1)), class: "btn btn-outline btn-sm", rel: "prev" %>
        <% end %>
        <span class="text-sm text-muted">Page <%= @page %> of <%= @total_pages %></span>
        <% if @page < @total_pages %>
          <%= link_to "Next", customers_path(request.query_parameters.merge(page: @page + 1)), class: "btn btn-outline btn-sm", rel: "next" %>
        <% end %>
      </div>
    </nav>
  <% end %>
</div>
