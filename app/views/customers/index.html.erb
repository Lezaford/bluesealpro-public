<div class="space-y-6">
  <!-- Header + actions -->
  <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <div>
      <h1 class="text-3xl font-extrabold">Customers</h1>
      <p class="mt-1 text-sm text-slate-400">
        Search, filter, import, and export customer records for <%= Current.company.name %>.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <!-- Export CSV -->
      <%= link_to "Export CSV",
          export_customers_path(request.query_parameters),
          class: "inline-flex items-center rounded-md border border-slate-600 px-3 py-2 text-sm font-medium text-slate-100 hover:bg-slate-800" %>

      <!-- Import CSV -->
      <%= form_with url: import_customers_path,
                    multipart: true,
                    local: true,
                    class: "flex items-center gap-2" do |f| %>
        <%= f.file_field :file,
              accept: ".csv",
              class: "block w-40 text-xs text-slate-300 file:mr-3 file:rounded-md file:border-0 file:bg-slate-700 file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-slate-100 hover:file:bg-slate-600" %>
        <%= f.submit "Import CSV",
              class: "inline-flex items-center rounded-md bg-slate-700 px-3 py-2 text-xs font-medium text-slate-100 hover:bg-slate-600" %>
      <% end %>

      <!-- New Customer -->
      <%= link_to "New Customer",
          new_customer_path,
          class: "inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
    </div>
  </div>

  <!-- Search + filters -->
  <%= form_with url: customers_path, method: :get, local: true, class: "max-w-4xl" do |f| %>
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <!-- Text search + buttons -->
      <div class="flex w-full gap-2">
        <%= text_field_tag :q, params[:q],
          placeholder: "Search name, email, phone…",
          class: "w-full rounded-md bg-slate-800 border border-slate-700 text-slate-100
                  focus:border-blue-500 focus:ring-blue-500 px-3 py-2" %>

        <%= submit_tag "Search",
          class: "rounded-md bg-slate-700 px-4 py-2 text-slate-100 hover:bg-slate-600" %>

        <% if params[:q].present? || params[:customer_type].present? || params[:lead_source].present? %>
          <%= link_to "Clear", customers_path,
            class: "rounded-md border border-slate-600 px-4 py-2 text-sm text-slate-100 hover:bg-slate-800" %>
        <% end %>
      </div>

      <!-- Dropdown filters -->
      <div class="flex flex-wrap gap-2 md:justify-end">
        <%= select_tag :customer_type,
          options_for_select(
            [["All types", ""]] + @customer_types.map { |t| [t, t] },
            params[:customer_type]
          ),
          class: "rounded-md bg-slate-800 border border-slate-700 text-sm text-slate-100 px-3 py-2" %>

        <%= select_tag :lead_source,
          options_for_select(
            [["All sources", ""]] + @lead_sources.map { |s| [s, s] },
            params[:lead_source]
          ),
          class: "rounded-md bg-slate-800 border border-slate-700 text-sm text-slate-100 px-3 py-2" %>
      </div>
  </div>
<% end %>


  <!-- Table -->
  <div class="overflow-hidden rounded-xl border border-slate-800 bg-slate-900">
    <table class="min-w-full divide-y divide-slate-800">
      <thead class="bg-slate-900/50">
        <tr>
          <th class="px-4 py-3 text-left text-sm font-semibold text-slate-300">Name</th>
          <th class="px-4 py-3 text-left text-sm font-semibold text-slate-300">Email</th>
          <th class="px-4 py-3 text-left text-sm font-semibold text-slate-300">Phone</th>
          <th class="px-4 py-3 text-left text-sm font-semibold text-slate-300">City</th>
          <th class="px-4 py-3 text-left text-sm font-semibold text-slate-300">Type</th>
          <th class="px-4 py-3 text-left text-sm font-semibold text-slate-300">Last Service</th>
          <th class="px-4 py-3 text-left text-sm font-semibold text-slate-300">Lifetime Value</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800">
        <% @customers.each do |c| %>
          <tr class="hover:bg-slate-800/60">
            <td class="px-4 py-3">
              <div class="flex flex-col">
                <span class="font-medium text-slate-100"><%= c.display_name.presence || "#{c.first_name} #{c.last_name}" %></span>
                <% if c.company_name.present? %>
                  <span class="text-xs text-slate-400"><%= c.company_name %></span>
                <% end %>
              </div>
            </td>
            <td class="px-4 py-3 text-sm text-slate-100"><%= c.email.presence || "—" %></td>
            <td class="px-4 py-3 text-sm text-slate-100">
              <%= c.phone.presence || c.mobile_number.presence || "—" %>
            </td>
            <td class="px-4 py-3 text-sm text-slate-100">
              <%= c.city.presence || c.address_1_city.presence || "—" %>
            </td>
            <td class="px-4 py-3 text-sm text-slate-100">
              <%= c.customer_type.presence || "—" %>
            </td>
            <td class="px-4 py-3 text-sm text-slate-100">
              <%= c.last_service_date&.strftime("%b %-d, %Y") || "—" %>
            </td>
            <td class="px-4 py-3 text-sm text-slate-100">
              <% if c.lifetime_value.present? && c.lifetime_value.to_f > 0 %>
                <span class="font-mono">$<%= number_with_precision(c.lifetime_value, precision: 2) %></span>
              <% else %>
                —
              <% end %>
            </td>
            <td class="px-4 py-3 text-right">
              <div class="inline-flex gap-2">
                <%= link_to "View", c,
                      class: "rounded-md border border-slate-600 px-3 py-1.5 text-xs text-slate-100 hover:bg-slate-800" %>
                <%= link_to "Edit", edit_customer_path(c),
                      class: "rounded-md border border-slate-600 px-3 py-1.5 text-xs text-slate-100 hover:bg-slate-800" %>
                <%= button_to "Delete", c, method: :delete,
                      data: { turbo_confirm: "Delete this customer?" },
                      class: "rounded-md bg-red-600 px-3 py-1.5 text-xs text-white hover:bg-red-700" %>
              </div>
            </td>
          </tr>
        <% end %>

        <% if @customers.empty? %>
          <tr>
            <td colspan="8" class="px-4 py-6 text-center text-slate-400">
              No customers yet.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
