<%
  tiles = [
    { title: "Customers",   text: "Manage your client list.",         path: customers_path,   icon: "users" },
    { title: "Schedule",    text: "Create and assign service calls.", path: schedule_path,    icon: "calendar" },
    { title: "Jobs",        text: "Track work and generate invoices.", path: jobs_path,        icon: "clipboard" },
    { title: "Technicians", text: "Manage your service team.",        path: technicians_path, icon: "wrench" }
  ]
  tiles << { title: "Users", text: "Create and manage team members.", path: admin_users_path, icon: "shield" } if current_user&.role_owner? || current_user&.role_admin?
%>
<div class="page">
  <header>
    <p class="eyebrow">Overview</p>
    <h1 class="page-title mt-1">Dashboard</h1>
    <p class="page-sub">Pick up where you left off.</p>
  </header>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% tiles.each do |t| %>
      <%= link_to t[:path], class: "card card-body card-link group" do %>
        <span class="grid h-10 w-10 place-items-center rounded-lg bg-brand-500/10 text-brand-600 dark:text-brand-300">
          <%= icon t[:icon], css: "h-5 w-5" %>
        </span>
        <h2 class="mt-4 text-lg font-semibold text-ink"><%= t[:title] %></h2>
        <p class="mt-1 text-sm text-muted"><%= t[:text] %></p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-link">
          Open <%= icon "arrow-right", css: "h-4 w-4 transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none" %>
        </span>
      <% end %>
    <% end %>
  </div>
</div>
