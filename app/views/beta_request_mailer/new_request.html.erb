<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />

    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        background-color: #f5f7fa;
        margin: 0;
        padding: 20px;
      }

      .email-container {
        background: #ffffff;
        max-width: 600px;
        margin: auto;
        border-radius: 10px;
        padding: 25px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
      }

      h2 {
        margin-top: 0;
        color: #1e3a8a;
        font-size: 22px;
      }

      .section-title {
        color: #334155;
        margin-top: 20px;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: bold;
      }

      .field {
        margin-bottom: 12px;
      }

      .field-label {
        font-weight: 600;
        color: #1e293b;
        font-size: 15px;
      }

      .field-value {
        margin-top: 2px;
        padding: 10px 12px;
        background: #f1f5f9;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        font-size: 15px;
        color: #0f172a;
      }

      .message-box {
        white-space: pre-wrap;
        line-height: 1.5;
      }

      .footer {
        margin-top: 25px;
        font-size: 12px;
        color: #64748b;
        text-align: center;
      }
    </style>
  </head>

  <body>
    <div class="email-container">

      <h2>New BlueSealPro Beta Request</h2>

      <div class="field">
        <div class="field-label">Name</div>
        <div class="field-value"><%= @beta_request.name %></div>
      </div>

      <div class="field">
        <div class="field-label">Email</div>
        <div class="field-value"><%= @beta_request.email %></div>
      </div>

      <div class="field">
        <div class="field-label">Company</div>
        <div class="field-value"><%= @beta_request.company %></div>
      </div>

      <div class="field">
        <div class="field-label">Phone</div>
        <div class="field-value"><%= @beta_request.phone %></div>
      </div>

      <% if @beta_request.message.present? %>
        <div class="section-title">Message</div>
        <div class="field-value message-box">
          <%= @beta_request.message %>
        </div>
      <% end %>

      <div class="footer">
        Sent automatically from BlueSealPro.com  
      </div>

    </div>
  </body>
</html>
