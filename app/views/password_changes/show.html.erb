<div class="page max-w-md mx-auto">
  <div>
    <h1 class="page-title">Set Your Password</h1>
    <p class="mt-2 text-muted">Welcome to BlueSealPro! Please create a secure password for your account.</p>
  </div>

  <div class="card card-body">
    <%= form_with model: @user, local: true, url: password_change_path, method: :patch, class: "space-y-6" do |f| %>
      <% if @user.errors.any? %>
        <div class="notice notice-error">
          <p class="font-semibold mb-1"><%= pluralize(@user.errors.count, "error") %> prevented saving:</p>
          <ul class="list-disc pl-5">
            <% @user.errors.full_messages.each do |m| %>
              <li><%= m %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :current_password, "Current Password *", class: "label" %>
        <%= f.password_field :current_password, class: "input" %>
        <p class="mt-1 text-xs text-muted">Enter the temporary password you received in your welcome email</p>
      </div>

      <div>
        <%= f.label :password, "New Password *", class: "label" %>
        <%= f.password_field :password, class: "input" %>
        <p class="mt-1 text-xs text-muted">Minimum 6 characters</p>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm Password *", class: "label" %>
        <%= f.password_field :password_confirmation, class: "input" %>
      </div>

      <div class="flex items-center gap-3 pt-4">
        <%= f.submit "Set Password",
            class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
