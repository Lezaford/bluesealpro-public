<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <h1 class="text-3xl font-extrabold">Dispatch Schedule</h1>
      <p class="mt-1 text-sm text-slate-400">
        View and manage technician assignments for <%= @date.strftime("%A, %B %d, %Y") %>
      </p>
    </div>

    <!-- Date Navigation -->
    <div class="flex items-center gap-3">
      <%= link_to "← Previous", schedule_path(date: @date - 1.day),
            class: "rounded-md border border-slate-600 px-3 py-2 text-sm font-medium text-slate-100 hover:bg-slate-800" %>
      
      <span class="min-w-max text-sm font-semibold text-slate-200">
        <%= @date.strftime("%b %d, %Y") %>
      </span>
      
      <%= link_to "Next →", schedule_path(date: @date + 1.day),
            class: "rounded-md border border-slate-600 px-3 py-2 text-sm font-medium text-slate-100 hover:bg-slate-800" %>
    </div>
  </div>

  <% if @technicians.empty? %>
    <!-- Empty State -->
    <div class="rounded-md border border-slate-700 bg-slate-800/50 px-6 py-8 text-center">
      <p class="text-slate-300 mb-4">No technicians have been added yet.</p>
      <%= link_to "Create your first technician", new_technician_path,
            class: "inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
    </div>
  <% else %>
    <!-- Schedule Grid -->
    <div class="overflow-x-auto rounded-xl border border-slate-800">
      <table class="min-w-full divide-y divide-slate-800 bg-slate-900">
        <thead class="bg-slate-900/50">
          <tr>
            <th class="px-4 py-3 text-left text-sm font-semibold text-slate-300 bg-slate-800/30 w-48 sticky left-0 z-10">Technician</th>
            <% @hours.each do |hour| %>
              <th class="px-3 py-3 text-center text-xs font-semibold text-slate-300 bg-slate-800/20">
                <%= hour < 12 ? "#{hour}:00 AM" : (hour == 12 ? "12:00 PM" : "#{hour - 12}:00 PM") %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <% @technicians.each do |tech| %>
            <tr class="hover:bg-slate-800/50">
              <td class="px-4 py-4 text-sm font-semibold text-slate-100 bg-slate-800/20 w-48 sticky left-0 z-10">
                <div><%= tech.name %></div>
                <div class="text-xs text-slate-400 font-normal mt-1"><%= tech.phone %></div>
              </td>
              <% @hours.each do |hour| %>
                <td class="border-l border-slate-800 px-3 py-4 h-32 align-top">
                  <div class="space-y-2 h-full flex flex-col">
                    <% @schedule[tech.id][hour].each do |job| %>
                      <div class="bg-blue-600/20 border border-blue-500/40 rounded-md p-2 text-xs cursor-pointer hover:bg-blue-600/30 hover:border-blue-500/60 transition-colors" 
                           title="<%= job.customer.full_name %> - <%= job.notes %>">
                        <div class="font-semibold text-blue-300 truncate"><%= job.customer.full_name %></div>
                        <div class="text-blue-200/70 text-xs truncate mt-0.5"><%= job.notes %></div>
                      </div>
                    <% end %>
                    <div class="mt-auto pt-2">
                      <%= button_to "+", schedule_path(date: @date, technician_id: tech.id, hour: hour), method: :get,
                            class: "w-full rounded-md bg-slate-700 px-2 py-1 text-xs font-medium text-slate-200 hover:bg-slate-600" %>
                    </div>
                  </div>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <!-- Footer Links -->
  <div class="flex gap-2">
    <%= link_to "Manage Technicians", technicians_path,
          class: "rounded-md border border-slate-600 px-4 py-2 text-sm font-medium text-slate-100 hover:bg-slate-800" %>
  </div>
</div>
