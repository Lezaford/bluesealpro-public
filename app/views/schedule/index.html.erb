<div class="p-6">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-3xl font-bold">Dispatch Schedule</h1>
    <div class="flex gap-4">
      <a href="<%= schedule_path(date: @date - 1.day) %>" class="btn btn-outline">← Previous Day</a>
      <span class="text-lg font-semibold"><%= @date.strftime("%A, %B %d, %Y") %></span>
      <a href="<%= schedule_path(date: @date + 1.day) %>" class="btn btn-outline">Next Day →</a>
    </div>
  </div>

  <% if @technicians.empty? %>
    <div class="alert alert-info">
      <p>No technicians added yet. <%= link_to "Add a technician", new_technician_path, class: "link" %></p>
    </div>
  <% else %>
    <div class="overflow-x-auto">
      <table class="table table-sm w-full border border-gray-300">
        <thead>
          <tr class="bg-gray-100">
            <th class="border border-gray-300 p-2 w-32">Technician</th>
            <% @hours.each do |hour| %>
              <th class="border border-gray-300 p-2 w-24 text-center">
                <%= hour < 12 ? "#{hour}:00 AM" : (hour == 12 ? "12:00 PM" : "#{hour - 12}:00 PM") %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @technicians.each do |tech| %>
            <tr class="hover:bg-gray-50">
              <td class="border border-gray-300 p-2 font-semibold bg-gray-50">
                <%= tech.name %>
                <div class="text-sm text-gray-600"><%= tech.phone %></div>
              </td>
              <% @hours.each do |hour| %>
                <td class="border border-gray-300 p-2 h-24 align-top relative bg-white">
                  <div class="space-y-1">
                    <% @schedule[tech.id][hour].each do |job| %>
                      <div class="bg-blue-100 border border-blue-300 rounded p-1 text-xs cursor-pointer hover:bg-blue-200" 
                           title="<%= job.customer.full_name %> - <%= job.notes %>">
                        <div class="font-semibold"><%= job.customer.full_name %></div>
                        <div class="truncate"><%= job.notes %></div>
                      </div>
                    <% end %>
                  </div>
                  <div class="absolute bottom-1 right-1">
                    <%= button_to "Add", schedule_path(date: @date, technician_id: tech.id, hour: hour), method: :get, class: "btn btn-xs btn-ghost" %>
                  </div>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="mt-6">
    <%= link_to "Manage Technicians", technicians_path, class: "btn btn-primary" %>
  </div>
</div>
