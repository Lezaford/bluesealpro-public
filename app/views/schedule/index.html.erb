<% hour_label = ->(h) { h < 12 ? "#{h} AM" : (h == 12 ? "12 PM" : "#{h - 12} PM") } %>
<div data-controller="dispatch-board" data-dispatch-board-date-value="<%= @date.to_date %>">
  <!-- Header -->
  <div class="mb-4 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <h1 class="page-title">Dispatch board</h1>
      <p class="mt-1 text-sm text-muted"><%= @date.strftime("%A, %B %d, %Y") %></p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <%= link_to "← Previous", schedule_path(date: @date - 1.day), class: "btn btn-outline btn-sm" %>
      <%= link_to "Today", schedule_path(date: Date.today), class: "btn btn-outline btn-sm" %>
      <input type="date"
             value="<%= @date.to_date %>"
             onchange="if (this.value) window.location.href = '<%= schedule_path("") %>' + this.value"
             class="input !w-auto !py-1.5" aria-label="Go to date">
      <%= link_to "Next →", schedule_path(date: @date + 1.day), class: "btn btn-outline btn-sm" %>
    </div>
  </div>

  <div class="flex flex-col gap-4 lg:flex-row lg:items-start">
    <!-- Unassigned queue -->
    <section class="flex max-h-60 w-full flex-shrink-0 flex-col overflow-hidden rounded-lg border border-line bg-raised/60 lg:max-h-[calc(100dvh-13rem)] lg:w-72"
             aria-labelledby="unassigned-heading">
      <div class="flex-shrink-0 border-b border-line bg-raised px-4 py-3">
        <h2 id="unassigned-heading" class="font-semibold text-ink-2">
          Unassigned jobs
          <span class="ml-1 text-xs font-normal text-muted">(<%= @unassigned_jobs.size %>)</span>
        </h2>
      </div>

      <div class="min-h-16 flex-1 space-y-2 overflow-y-auto p-3 transition-colors"
           data-dispatch-board-target="unassignedContainer"
           data-action="dragover->dispatch-board#dragOverUnassigned dragleave->dispatch-board#dragLeaveUnassigned drop->dispatch-board#dropUnassigned">
        <% if @unassigned_jobs.any? %>
          <% @unassigned_jobs.each do |job| %>
            <div class="job-card cursor-move rounded-lg border border-amber-500/40 bg-amber-500/10 p-3 transition-colors hover:bg-amber-500/20"
                 data-dispatch-board-target="job"
                 data-job-id="<%= job.id %>"
                 draggable="true"
                 data-action="dragstart->dispatch-board#dragStart dragend->dispatch-board#dragEnd">
              <div class="truncate text-sm font-semibold text-amber-800 dark:text-amber-200"><%= job.customer.full_name %></div>
              <div class="mt-1 line-clamp-2 text-xs text-ink-2"><%= job.notes || job.complaint || "No details" %></div>
              <div class="mt-2 text-xs"><%= link_to "View", job_path(job), class: "link" %></div>
            </div>
          <% end %>
        <% else %>
          <p class="py-6 text-center text-sm text-muted">All jobs assigned</p>
        <% end %>
      </div>
    </section>

    <!-- Technician board: one scroll container; sticky time header (top) and technician column (left) -->
    <section class="min-w-0 flex-1" aria-label="Technician schedule for <%= @date.strftime("%B %d") %>">
      <% if @technicians.empty? %>
        <div class="rounded-lg border border-line bg-raised/60 p-8 text-center text-sm text-muted">
          No active technicians. <%= link_to "Add a technician", new_technician_path, class: "link" %> to start scheduling.
        </div>
      <% else %>
        <div class="max-h-[calc(100dvh-13rem)] min-h-80 overflow-auto overscroll-contain rounded-lg border border-line bg-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
             tabindex="0" role="region" aria-label="Schedule grid, scrollable">
          <div class="grid w-max min-w-full"
               style="grid-template-columns: 9.5rem repeat(<%= @hours.size %>, 9rem);">
            <!-- Corner -->
            <div class="sticky left-0 top-0 z-30 border-b border-r border-line bg-raised px-3 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-muted">Technician</p>
            </div>
            <% @hours.each do |hour| %>
              <div class="sticky top-0 z-20 border-b border-r border-line bg-raised px-3 py-3 text-xs font-semibold text-muted"><%= hour_label.call(hour) %></div>
            <% end %>

            <% @technicians.each do |tech| %>
              <% assigned_jobs = @assigned_jobs[tech.id] || [] %>
              <div class="sticky left-0 z-10 border-b border-r border-line bg-raised px-3 py-3">
                <div class="truncate font-semibold text-ink-2" title="<%= tech.name %>"><%= tech.name %></div>
                <% if tech.phone.present? %><div class="mt-0.5 truncate text-xs text-muted"><%= tech.phone %></div><% end %>
                <div class="mt-1 text-xs text-muted"><%= pluralize(assigned_jobs.size, "job") %></div>
              </div>
              <% @hours.each do |hour| %>
                <% slot_jobs = assigned_jobs.select { |job| job.starts_at && job.starts_at.hour == hour && job.starts_at.to_date == @date.to_date } %>
                <div class="min-h-24 space-y-1 border-b border-r border-line bg-surface p-1.5 transition-colors hover:bg-raised/60"
                     data-dispatch-board-target="timeSlot"
                     data-technician-id="<%= tech.id %>"
                     data-hour="<%= hour %>"
                     data-action="dragover->dispatch-board#dragOverSlot dragleave->dispatch-board#dragLeaveSlot drop->dispatch-board#dropSlot">
                  <% slot_jobs.each do |job| %>
                    <div class="job-card cursor-move rounded-md border border-blue-500/40 bg-blue-500/15 p-2 text-xs transition-colors hover:border-blue-500 hover:bg-blue-500/25"
                         data-dispatch-board-target="job"
                         data-job-id="<%= job.id %>"
                         draggable="true"
                         data-action="dragstart->dispatch-board#dragStart dragend->dispatch-board#dragEnd">
                      <div class="truncate font-semibold text-blue-800 dark:text-blue-200"><%= job.customer.full_name %></div>
                      <div class="mt-0.5 truncate text-ink-2"><%= job.starts_at.strftime("%-I:%M %p") %> &middot; <%= job.notes || job.complaint || "—" %></div>
                      <div class="mt-1"><%= link_to "View", job_path(job), class: "link" %></div>
                    </div>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>
  </div>
</div>
