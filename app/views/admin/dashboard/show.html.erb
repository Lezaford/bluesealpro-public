<div class="p-6">
  <h1 class="text-4xl font-bold mb-2">Admin Dashboard</h1>
  <p class="text-gray-600 mb-8"><%= current_company.name %></p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Company Settings Card -->
    <div class="card bg-base-100 shadow-lg">
      <div class="card-body">
        <h2 class="card-title text-xl">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          Company Settings
        </h2>
        <p class="mb-4">Manage company information, contact details, and branding</p>
        <%= link_to "Go to Settings", edit_admin_company_path, class: "btn btn-primary btn-sm" %>
      </div>
    </div>

    <!-- Employees & Permissions Card -->
    <div class="card bg-base-100 shadow-lg">
      <div class="card-body">
        <h2 class="card-title text-xl">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.856-1.487M15 10a3 3 0 11-6 0 3 3 0 016 0zM15 20H9m6 0h6"></path>
          </svg>
          Employees & Permissions
        </h2>
        <p class="mb-4">Manage user roles and access permissions</p>
        <%= link_to "Go to Employees", admin_users_path, class: "btn btn-primary btn-sm" %>
      </div>
    </div>

    <!-- Customers Card -->
    <div class="card bg-base-100 shadow-lg">
      <div class="card-body">
        <h2 class="card-title text-xl">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 10H9m6 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Customers
        </h2>
        <p class="mb-4">View and manage customer database</p>
        <%= link_to "Go to Customers", customers_path, class: "btn btn-primary btn-sm" %>
      </div>
    </div>

    <!-- Jobs Card -->
    <div class="card bg-base-100 shadow-lg">
      <div class="card-body">
        <h2 class="card-title text-xl">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
          </svg>
          Jobs
        </h2>
        <p class="mb-4">View and manage all service jobs</p>
        <%= link_to "Go to Jobs", jobs_path, class: "btn btn-primary btn-sm" %>
      </div>
    </div>
  </div>
</div>
