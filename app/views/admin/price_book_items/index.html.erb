<div class="page">
  <!-- Header -->
  <div class="page-header">
    <div>
      <h1 class="page-title">Price Book</h1>
      <p class="text-sm text-muted mt-1"><%= @price_book_items.count %> items</p>
    </div>
    <%= link_to "Add Item", new_admin_price_book_item_path, class: "btn btn-primary" %>
  </div>

  <!-- Items Table -->
  <div class="rounded-lg border border-line overflow-hidden">
    <% if @price_book_items.any? %>
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th class="text-left">Name</th>
              <th class="text-left">Category</th>
              <th class="text-right">Unit Price</th>
              <th class="text-center">Tax</th>
              <th class="text-center">Policy</th>
              <th class="text-center">Active</th>
              <th class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @price_book_items.each do |item| %>
              <tr>
                <td><%= item.name %></td>
                <td><%= item.category %></td>
                <td class="text-right">$<%= (item.unit_price_cents / 100.0).round(2) %></td>
                <td class="text-center"><%= item.taxable? ? "✓" : "–" %></td>
                <td class="text-center">
                  <span class="<%= item.lock_policy == 'admin_only' ? 'text-yellow-700 dark:text-yellow-300' : 'text-link' %>">
                    <%= item.lock_policy.humanize %>
                  </span>
                </td>
                <td class="text-center">
                  <% if item.active? %>
                    <span class="badge badge-success">Active</span>
                  <% else %>
                    <span class="badge badge-warning">Inactive</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <%= link_to "Edit", edit_admin_price_book_item_path(item), class: "btn btn-xs btn-outline" %>
                  <%= button_to "Delete", admin_price_book_item_path(item), method: :delete, 
                      data: { turbo_confirm: "Remove this item?" }, class: "btn btn-xs btn-error btn-outline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-6 py-8 text-center text-muted">
        <p class="text-sm mb-4">No price book items yet</p>
        <%= link_to "Create the first one", new_admin_price_book_item_path, class: "btn btn-sm btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
