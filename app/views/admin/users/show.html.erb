<div class="page">
  <div class="mb-6">
    <h1 class="page-title"><%= @user.name %></h1>
  </div>

  <div class="card bg-base-100 shadow-lg max-w-md">
    <div class="card-body">
      <div class="mb-4">
        <h2 class="text-sm font-semibold text-muted">Email</h2>
        <p class="text-lg"><%= mail_to @user.email %></p>
      </div>

      <div class="mb-4">
        <h2 class="text-sm font-semibold text-muted">Role</h2>
        <p>
          <span class="badge <%= role_badge_class(@user.role) %>">
            <%= @user.role.humanize %>
          </span>
        </p>
      </div>

      <div class="card-actions mt-6">
        <%= link_to "Edit", edit_admin_user_path(@user), class: "btn btn-primary" %>
        <%= link_to "Back to Users", admin_users_path, class: "btn btn-outline" %>
      </div>
    </div>
  </div>
</div>
