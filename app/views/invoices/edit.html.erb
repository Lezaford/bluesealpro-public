<div class="page max-w-5xl mx-auto">
  <!-- Header -->
  <div class="page-header">
    <div>
      <h1 class="page-title">Edit Invoice</h1>
      <p class="text-sm text-muted mt-1">Job: <%= link_to @invoice.job.customer.full_name, job_path(@invoice.job), class: "link" %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "View", invoice_path(@invoice), class: "btn btn-primary" %>
      <%= link_to "Back to Job", job_path(@invoice.job), class: "btn btn-outline" %>
    </div>
  </div>

  <!-- Line Items Sections -->
  <% %w[service labor materials discount].each do |cat| %>
    <% cat_items = @invoice.line_items.by_category(cat) %>
    <div class="rounded-lg border border-line bg-raised/60 overflow-hidden">
      <div class="bg-raised px-6 py-3 border-b border-line flex items-center justify-between">
        <h3 class="font-semibold text-ink-2 capitalize"><%= cat.humanize %></h3>
        
        <!-- Add buttons -->
        <div class="space-x-2">
          <% if current_user.role_owner? || current_user.role_admin? %>
            <% if @price_book_items_by_category[cat].present? %>
              <button type="button" class="btn btn-sm btn-outline" 
                      onclick="document.getElementById('add-<%= cat %>-form').scrollIntoView(); document.getElementById('add-<%= cat %>-form').style.display='block'">
                + Add from Price Book
              </button>
            <% end %>
          <% end %>
          
          <% if cat == "materials" && (current_user.role_tech? || current_user.role_owner? || current_user.role_admin?) %>
            <button type="button" class="btn btn-sm btn-outline" 
                    onclick="document.getElementById('custom-<%= cat %>-form').scrollIntoView(); document.getElementById('custom-<%= cat %>-form').style.display='block'">
              + Add Material
            </button>
          <% end %>
        </div>
      </div>

      <!-- Line items table -->
      <% if cat_items.any? %>
        <div class="overflow-x-auto">
          <table class="table">
            <thead>
              <tr>
                <th class="text-left">Description</th>
                <th class="text-right">Qty</th>
                <th class="text-right">Unit Price</th>
                <th class="text-right">Amount</th>
                <th class="text-center">Tax</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% cat_items.each do |item| %>
                <tr>
                  <td>
                    <div class="flex items-center gap-2">
                      <% if item.locked? %>
                        <span title="Locked">🔒</span>
                      <% end %>
                      <%= item.description %>
                    </div>
                  </td>
                  <td class="text-right"><%= item.quantity %></td>
                  <td class="text-right">$<%= (item.unit_price_cents / 100.0).round(2) %></td>
                  <td class="text-right">$<%= (item.total_cents / 100.0).round(2) %></td>
                  <td class="text-center"><%= item.taxable? ? "✓" : "–" %></td>
                  <td class="text-center">
                    <% if !item.locked? || current_user.role_owner? || current_user.role_admin? %>
                      <%= button_to "Delete", invoice_line_item_path(@invoice, item), method: :delete, 
                          data: { turbo_confirm: "Remove this line item?" }, class: "btn btn-xs btn-error btn-outline" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-6 py-8 text-center text-muted">
          <p class="text-sm">No <%= cat %> items yet</p>
        </div>
      <% end %>

      <!-- Add from Price Book Form (hidden, shown on click) -->
      <% if (current_user.role_owner? || current_user.role_admin?) && @price_book_items_by_category[cat].present? %>
        <div id="add-<%= cat %>-form" class="px-6 py-4 border-t border-line bg-raised/60" style="display: none;">
          <%= form_with url: invoice_line_items_path(@invoice), method: :post, local: true do |f| %>
            <div class="flex items-end gap-3">
              <%= f.select :price_book_item_id, 
                  options_from_collection_for_select(@price_book_items_by_category[cat], :id, :name),
                  { prompt: "Select item..." },
                  class: "input input-bordered flex-1" %>
              <%= f.submit "Add", class: "btn btn-primary" %>
              <button type="button" class="btn btn-outline" 
                      onclick="document.getElementById('add-<%= cat %>-form').style.display='none'">Cancel</button>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Custom Material Form (hidden, shown on click) -->
      <% if cat == "materials" && (current_user.role_tech? || current_user.role_owner? || current_user.role_admin?) %>
        <div id="custom-<%= cat %>-form" class="px-6 py-4 border-t border-line bg-raised/60 space-y-3" style="display: none;">
          <%= form_with url: invoice_line_items_path(@invoice), method: :post, local: true do |f| %>
            <%= f.hidden_field :category, value: "materials" %>
            
            <div>
              <%= f.label :description, "Description" %>
              <%= f.text_field :description, class: "input input-bordered w-full", placeholder: "e.g., HVAC Filter" %>
            </div>

            <div class="grid grid-cols-3 gap-3">
              <div>
                <%= f.label :quantity, "Qty" %>
                <%= f.number_field :quantity, value: 1, step: 0.01, class: "input input-bordered w-full" %>
              </div>
              <div>
                <%= f.label :unit_price_cents, "Unit Price ($)" %>
                <%= f.number_field :unit_price_cents, value: 0, step: 1, class: "input input-bordered w-full", placeholder: "0" %>
              </div>
              <div>
                <%= f.label :taxable, "Taxable?" %>
                <%= f.check_box :taxable, { class: "checkbox" }, "1", "0" %>
              </div>
            </div>

            <div class="flex gap-2">
              <%= f.submit "Add Material", class: "btn btn-primary" %>
              <button type="button" class="btn btn-outline" 
                      onclick="document.getElementById('custom-<%= cat %>-form').style.display='none'">Cancel</button>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Totals -->
  <div class="rounded-lg border border-line bg-raised/60 overflow-hidden">
    <div class="px-6 py-4 space-y-3">
      <div class="flex justify-between text-ink-2">
        <span>Subtotal:</span>
        <span class="font-semibold">$<%= @invoice.subtotal_dollars.round(2) %></span>
      </div>
      
      <div class="flex justify-between text-ink-2">
        <span>Tax Rate:</span>
        <span><%= (@invoice.company.tax_rate * 100).round(1) %>%</span>
      </div>
      
      <div class="flex justify-between text-ink-2">
        <span>Tax:</span>
        <span class="font-semibold">$<%= @invoice.tax_dollars.round(2) %></span>
      </div>
      
      <div class="flex justify-between text-lg font-bold text-ink border-t border-line pt-3">
        <span>Total:</span>
        <span>$<%= @invoice.total_dollars.round(2) %></span>
      </div>
    </div>
  </div>
</div>
