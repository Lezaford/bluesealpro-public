<div class="page max-w-4xl mx-auto">
  <!-- Header -->
  <div class="page-header">
    <div>
      <h1 class="page-title">Invoice</h1>
      <p class="text-sm text-muted mt-1">Job: <%= link_to @invoice.job.customer.full_name, job_path(@invoice.job), class: "link" %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Edit", edit_invoice_path(@invoice), class: "btn btn-primary" %>
      <%= link_to "Back to Job", job_path(@invoice.job), class: "btn btn-outline" %>
    </div>
  </div>

  <!-- Company & Invoice Info -->
  <div class="grid md:grid-cols-2 gap-6">
    <div class="panel !p-6">
      <h2 class="font-semibold text-ink-2 mb-3">Company Info</h2>
      <p class="text-ink"><%= @invoice.company.name %></p>
      <p class="text-muted text-sm"><%= @invoice.company.phone %></p>
      <p class="text-muted text-sm"><%= @invoice.company.email %></p>
    </div>
    
    <div class="panel !p-6">
      <h2 class="font-semibold text-ink-2 mb-3">Customer Info</h2>
      <p class="text-ink"><%= @invoice.job.customer.full_name %></p>
      <p class="text-muted text-sm"><%= @invoice.job.customer.phone %></p>
      <p class="text-muted text-sm"><%= @invoice.job.customer.email %></p>
    </div>
  </div>

  <!-- Line Items by Category -->
  <% %w[service labor materials discount].each do |cat| %>
    <% cat_items = @invoice.line_items.by_category(cat) %>
    <% if cat_items.any? %>
      <div class="rounded-lg border border-line bg-raised/60 overflow-hidden">
        <div class="bg-raised px-6 py-3 border-b border-line">
          <h3 class="font-semibold text-ink-2 capitalize"><%= cat.humanize %></h3>
        </div>
        
        <div class="overflow-x-auto">
          <table class="table">
            <thead>
              <tr>
                <th class="text-left">Description</th>
                <th class="text-right">Qty</th>
                <th class="text-right">Unit Price</th>
                <th class="text-right">Amount</th>
                <th class="text-center">Tax</th>
              </tr>
            </thead>
            <tbody>
              <% cat_items.each do |item| %>
                <tr>
                  <td>
                    <div class="flex items-center gap-2">
                      <%= item.description %>
                      <% if item.locked? %>
                        <span class="badge badge-warning" title="Locked - Admin only">Locked</span>
                      <% end %>
                    </div>
                  </td>
                  <td class="text-right"><%= item.quantity %></td>
                  <td class="text-right">$<%= (item.unit_price_cents / 100.0).round(2) %></td>
                  <td class="text-right">$<%= (item.total_cents / 100.0).round(2) %></td>
                  <td class="text-center"><%= item.taxable? ? "✓" : "–" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  <% end %>

  <!-- Totals -->
  <div class="rounded-lg border border-line bg-raised/60 overflow-hidden">
    <div class="px-6 py-4 space-y-3">
      <div class="flex justify-between text-ink-2">
        <span>Subtotal:</span>
        <span class="font-semibold">$<%= @invoice.subtotal_dollars.round(2) %></span>
      </div>
      
      <div class="flex justify-between text-ink-2">
        <span>Tax Rate:</span>
        <span><%= (@invoice.company.tax_rate * 100).round(1) %>%</span>
      </div>
      
      <div class="flex justify-between text-ink-2">
        <span>Tax:</span>
        <span class="font-semibold">$<%= @invoice.tax_dollars.round(2) %></span>
      </div>
      
      <div class="flex justify-between text-lg font-bold text-ink border-t border-line pt-3">
        <span>Total:</span>
        <span>$<%= @invoice.total_dollars.round(2) %></span>
      </div>
    </div>
  </div>
</div>
