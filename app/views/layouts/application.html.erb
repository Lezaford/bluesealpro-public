<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <title>BlueSealPro</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#2563eb">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      // Dark by default; honour a saved choice. Runs before paint to avoid a flash.
      (function () {
        if (localStorage.getItem("bsp-theme") === "light") document.documentElement.classList.remove("dark");
      })();
    </script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col">
    <a href="#main"
       class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[60] focus:rounded-lg focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white">
      Skip to content
    </a>

    <header data-controller="menu" class="sticky top-0 z-40 border-b border-line bg-surface/85 backdrop-blur supports-[backdrop-filter]:bg-surface/70">
      <nav aria-label="Primary" class="mx-auto flex h-16 max-w-7xl items-center gap-2 px-4 sm:px-6 lg:px-8">
        <%= link_to (user_signed_in? ? dashboard_path : root_path), class: "mr-2 flex items-center gap-2.5 rounded-lg pr-2", "aria-label": "BlueSealPro home" do %>
          <span class="grid h-9 w-9 place-items-center rounded-lg bg-brand-600 text-white shadow-sm"><%= icon "clipboard", css: "h-5 w-5" %></span>
          <span class="text-base font-bold tracking-tight text-ink">BlueSeal<span class="text-link"> Pro</span></span>
        <% end %>

        <% if user_signed_in? %>
          <%# Desktop links %>
          <div class="ml-2 hidden items-center gap-1 md:flex">
            <%= nav_link_to "Dashboard", dashboard_path %>
            <%= nav_link_to "Customers", customers_path %>
            <%= nav_link_to "Jobs", jobs_path %>
            <%= nav_link_to "Schedule", schedule_path %>
            <%= nav_link_to "Technicians", technicians_path %>
            <% if current_user&.role_owner? || current_user&.role_admin? %>
              <%= nav_link_to "Users", admin_users_path %>
            <% end %>
          </div>
        <% end %>

        <div class="ml-auto flex items-center gap-2">
          <% if user_signed_in? %>
            <div class="relative" data-controller="menu">
              <button type="button" class="btn btn-primary btn-sm" aria-haspopup="true" aria-expanded="false"
                      data-menu-target="button" data-action="menu#toggle">
                <%= icon "plus", css: "h-4 w-4" %> New
              </button>
              <div class="menu-panel right-0 hidden" data-menu-target="panel">
                <%= link_to new_job_path, class: "menu-item" do %><%= icon "clipboard", css: "h-4 w-4 text-muted" %> New job<% end %>
                <%= link_to new_customer_path, class: "menu-item" do %><%= icon "users", css: "h-4 w-4 text-muted" %> New customer<% end %>
                <%= link_to new_technician_path, class: "menu-item" do %><%= icon "wrench", css: "h-4 w-4 text-muted" %> New technician<% end %>
              </div>
            </div>
          <% end %>

          <button type="button" class="btn btn-ghost !px-2.5" data-controller="theme" data-action="theme#toggle" aria-pressed="true" aria-label="Switch to light theme">
            <span data-theme-target="sun"><%= icon "sun" %></span>
            <span data-theme-target="moon" class="hidden"><%= icon "moon" %></span>
          </button>

          <% if user_signed_in? %>
            <%= button_to destroy_user_session_path, method: :delete, class: "btn btn-outline btn-sm hidden md:inline-flex", form_class: "hidden md:block" do %>
              Log out
            <% end %>
            <button type="button" class="btn btn-ghost !px-2.5 md:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav"
                    data-menu-target="button" data-action="menu#toggle">
              <%= icon "menu" %>
            </button>
          <% else %>
            <%= link_to "Log in", new_user_session_path, class: "btn btn-primary btn-sm" %>
          <% end %>
        </div>
      </nav>

      <% if user_signed_in? %>
        <div id="mobile-nav" data-menu-target="panel" class="hidden border-t border-line bg-surface md:hidden">
          <div class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-3">
            <%= nav_link_to "Dashboard", dashboard_path %>
            <%= nav_link_to "Customers", customers_path %>
            <%= nav_link_to "Jobs", jobs_path %>
            <%= nav_link_to "Schedule", schedule_path %>
            <%= nav_link_to "Technicians", technicians_path %>
            <% if current_user&.role_owner? || current_user&.role_admin? %>
              <%= nav_link_to "Users", admin_users_path %>
            <% end %>
            <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "nav-link w-full text-left", form_class: "mt-1 border-t border-line pt-2" %>
          </div>
        </div>
      <% end %>
    </header>

    <main id="main" class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6 lg:px-8">
      <% unless devise_controller? %>
        <div class="mb-6 space-y-3 empty:hidden" aria-live="polite">
          <% if notice.present? %>
            <div class="notice notice-success" role="status"><%= icon "check", css: "mt-0.5 h-4 w-4 shrink-0" %><span><%= notice %></span></div>
          <% end %>
          <% if alert.present? %>
            <div class="notice notice-error" role="alert"><span><%= alert %></span></div>
          <% end %>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <%= render "shared/demo_notice" %>
  </body>
</html>
