<!DOCTYPE html>
<html class="dark">
  <head>
  <title>BlueSealPro</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <script>
    // Dark by default; prefer saved choice if present.
    (function () {
      var saved = localStorage.getItem("bsp-theme");
      var root  = document.documentElement;
      if (saved === "light") { root.classList.remove("dark"); } else { root.classList.add("dark"); }
      // Wire up toggle after DOM is ready
      window.addEventListener("DOMContentLoaded", function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        function label(){ btn.textContent = root.classList.contains("dark") ? "Light" : "Dark"; }
        label();
        btn.addEventListener("click", function () {
          root.classList.toggle("dark");
          localStorage.setItem("bsp-theme", root.classList.contains("dark") ? "dark" : "light");
          label();
        });
      });
    })();
  </script>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
<script>
      // Apply saved theme before paint
      (function(){
        const t = localStorage.getItem("bsp-theme");
        if (t === "dark" || (!t && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <!-- Top Nav -->
    <nav class="bg-white/80 backdrop-blur border-b border-slate-200 dark:bg-slate-900/70 dark:border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <picture>
            <!-- Dark mode: white/black logo -->
            <source 
              srcset="<%= asset_path('BlueSealPro/BlueSealPro_blackwhite.png') %>" 
              media="(prefers-color-scheme: dark)">
    
            <!-- Light mode: full-color transparent version -->
            <source 
              srcset="<%= asset_path('BlueSealPro/BlueSealPro_transparent.png') %>" 
              media="(prefers-color-scheme: light)">
    
            <!-- Fallback (light mode default) -->
            <img 
              src="<%= asset_path('BlueSealPro/BlueSealPro_transparent.png') %>" 
              alt="BlueSealPro Logo"
              class="h-6 w-auto select-none">
          </picture>

          <span class="font-semibold">BlueSealPro</span>
        </div>


        <div class="flex items-center gap-3 text-sm">
          <% if user_signed_in? %>
          <%= link_to "Dashboard", dashboard_path, class: "hover:text-brand-400" %>
          <%= link_to "Customers", customers_path, class: "hover:text-brand-400" %>
          <%= link_to "Technicians", technicians_path, class: "hover:text-brand-400" %>
          <%= link_to "Schedule", schedule_path, class: "hover:text-brand-400" %>

          <% if current_user&.owner_role? || current_user&.admin_role? %>
            <%= link_to "Users", admin_users_path, class: "hover:text-purple-400 font-semibold" %>
          <% end %>
          <% end %>

          <%# Theme toggle %>
          <button id="theme-toggle"
                  class="inline-flex items-center rounded-md border border-slate-300/60 dark:border-slate-700
                        px-3 py-1.5 text-sm text-slate-700 dark:text-slate-200
                        hover:bg-slate-100 dark:hover:bg-slate-800">
          Light
          </button>

          <% if user_signed_in? %>
            <%= button_to "Logout", destroy_user_session_path, method: :delete,
                  class: "ml-1 inline-flex items-center rounded-md bg-red-600 px-3 py-1.5 text-white hover:bg-red-700" %>
          <% else %>
            <%= link_to "Login", new_user_session_path,
                  class: "inline-flex items-center rounded-md bg-brand-500 px-3 py-1.5 text-white hover:bg-brand-600" %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="max-w-7xl mx-auto p-6">
      <%= yield %>
    </main>
  </body>

</html>
