<!DOCTYPE html>
<html class="dark">
  <head>
  <title>BlueSealPro</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <script>
    // Dark by default; prefer saved choice if present.
    (function () {
      var saved = localStorage.getItem("bsp-theme");
      var root  = document.documentElement;
      if (saved === "light") { root.classList.remove("dark"); } else { root.classList.add("dark"); }
      // Wire up toggle after DOM is ready
      window.addEventListener("DOMContentLoaded", function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        function label(){ btn.textContent = root.classList.contains("dark") ? "Light" : "Dark"; }
        label();
        btn.addEventListener("click", function () {
          root.classList.toggle("dark");
          localStorage.setItem("bsp-theme", root.classList.contains("dark") ? "dark" : "light");
          label();
        });
      });
    })();
  </script>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
<script>
      // Apply saved theme before paint
      (function(){
        const t = localStorage.getItem("bsp-theme");
        if (t === "dark" || (!t && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <!-- Top Nav -->
    <nav class="bg-blue-600 border-b border-blue-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-28 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <img 
            src="<%= asset_path('BlueSealPro/BlueSealPro_primary.png') %>" 
            alt="BlueSealPro Logo"
            class="h-28 w-auto select-none">
        </div>


        <div class="flex items-center gap-3 text-sm text-white">
          <% if user_signed_in? %>
          <!-- New Button Dropdown -->
          <div class="relative">
            <button id="new-btn"
                    class="inline-flex items-center gap-1 rounded-md bg-blue-700 px-3 py-2 text-sm font-semibold hover:bg-blue-800 transition-colors"
                    title="Create new item">
              <span>+ New</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
            </button>

            <!-- New Dropdown Menu -->
            <div id="new-menu"
                 class="hidden absolute left-0 mt-2 w-48 bg-slate-800 border border-slate-700 rounded-lg shadow-xl z-50">
              <div class="p-2 space-y-1">
                <%= link_to new_customer_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-md hover:bg-slate-700 transition-colors" do %>
                  <span class="text-lg">👥</span>
                  <span>New Customer</span>
                <% end %>
                
                <%= link_to new_technician_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-md hover:bg-slate-700 transition-colors" do %>
                  <span class="text-lg">🔧</span>
                  <span>New Technician</span>
                <% end %>
                
                <%= link_to new_job_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-md hover:bg-slate-700 transition-colors" do %>
                  <span class="text-lg">📋</span>
                  <span>New Job</span>
                <% end %>
              </div>
            </div>
          </div>

          <!-- App Launcher Menu -->
          <div class="relative">
            <button id="app-launcher-btn"
                    class="inline-flex items-center justify-center w-10 h-10 rounded-full hover:bg-blue-700 transition-colors"
                    title="Open menu">
              <!-- 9-dot grid icon -->
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <circle cx="3" cy="3" r="1.5"/>
                <circle cx="12" cy="3" r="1.5"/>
                <circle cx="21" cy="3" r="1.5"/>
                <circle cx="3" cy="12" r="1.5"/>
                <circle cx="12" cy="12" r="1.5"/>
                <circle cx="21" cy="12" r="1.5"/>
                <circle cx="3" cy="21" r="1.5"/>
                <circle cx="12" cy="21" r="1.5"/>
                <circle cx="21" cy="21" r="1.5"/>
              </svg>
            </button>

            <!-- Dropdown Menu -->
            <div id="app-launcher-menu"
                 class="hidden absolute right-0 mt-2 w-48 bg-slate-800 border border-slate-700 rounded-lg shadow-xl z-50">
              <div class="p-2 space-y-1">
                <%= link_to dashboard_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-md hover:bg-slate-700 transition-colors" do %>
                  <span class="text-lg">📊</span>
                  <span>Dashboard</span>
                <% end %>
                
                <%= link_to customers_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-md hover:bg-slate-700 transition-colors" do %>
                  <span class="text-lg">👥</span>
                  <span>Customers</span>
                <% end %>
                
                <%= link_to technicians_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-md hover:bg-slate-700 transition-colors" do %>
                  <span class="text-lg">🔧</span>
                  <span>Technicians</span>
                <% end %>
                
                <%= link_to schedule_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-md hover:bg-slate-700 transition-colors" do %>
                  <span class="text-lg">📅</span>
                  <span>Schedule</span>
                <% end %>

                <% if current_user&.role_owner? || current_user&.role_admin? %>
                  <div class="border-t border-slate-700 my-1"></div>
                  <%= link_to admin_users_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-md hover:bg-slate-700 transition-colors font-semibold text-purple-300" do %>
                    <span class="text-lg">👤</span>
                    <span>Users</span>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

          <% end %>

          <% if user_signed_in? %>
            <%= button_to "Logout", destroy_user_session_path, method: :delete,
                  class: "ml-1 inline-flex items-center rounded-md bg-red-600 px-3 py-1.5 text-white hover:bg-red-700" %>
          <% else %>
            <%= link_to "Login", new_user_session_path,
                  class: "inline-flex items-center rounded-md bg-blue-800 px-3 py-1.5 text-white hover:bg-blue-900" %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="max-w-7xl mx-auto p-6">
      <%= yield %>
    </main>

    <script>
      // App launcher menu toggle
      const launcherBtn = document.getElementById('app-launcher-btn');
      const launcherMenu = document.getElementById('app-launcher-menu');
      
      // New button dropdown toggle
      const newBtn = document.getElementById('new-btn');
      const newMenu = document.getElementById('new-menu');

      // Launcher menu
      if (launcherBtn && launcherMenu) {
        launcherBtn.addEventListener('click', () => {
          launcherMenu.classList.toggle('hidden');
          newMenu?.classList.add('hidden'); // Close new menu if open
        });

        // Close menu when clicking outside
        document.addEventListener('click', (e) => {
          if (!launcherBtn.contains(e.target) && !launcherMenu.contains(e.target)) {
            launcherMenu.classList.add('hidden');
          }
        });

        // Close menu when a link is clicked
        launcherMenu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            launcherMenu.classList.add('hidden');
          });
        });
      }

      // New button menu
      if (newBtn && newMenu) {
        newBtn.addEventListener('click', () => {
          newMenu.classList.toggle('hidden');
          launcherMenu?.classList.add('hidden'); // Close app launcher if open
        });

        // Close menu when clicking outside
        document.addEventListener('click', (e) => {
          if (!newBtn.contains(e.target) && !newMenu.contains(e.target)) {
            newMenu.classList.add('hidden');
          }
        });

        // Close menu when a link is clicked
        newMenu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            newMenu.classList.add('hidden');
          });
        });
      }
    </script>
  </body>

</html>
