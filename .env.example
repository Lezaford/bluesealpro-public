# Copy to .env (gitignored) for local development. Never commit real values.
# Development/test DB credentials are in config/database.yml (local-only defaults).

# Production only:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# RAILS_MASTER_KEY=            # or SECRET_KEY_BASE=<output of `bin/rails secret`>
# FORCE_SSL=true               # set false only for plain-HTTP local container testing
# RAILS_LOG_LEVEL=info
