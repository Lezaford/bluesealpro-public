#!/bin/bash -e
# Dev container entrypoint: install deps, build CSS, prepare the DB, then exec the command.
cd /rails

bundle check >/dev/null 2>&1 || bundle install
[ -x node_modules/.bin/tailwindcss ] || npm ci
npm run build:css

rm -f tmp/pids/server.pid

# Only the web server prepares the DB (creates, migrates, seeds on first run).
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ] || [ "$1" == "./bin/rails" ] && [ "$2" == "server" ]; then
  ./bin/rails db:prepare
  ./bin/rails db:seed
fi

exec "${@}"
